# ========================================================
# Kasa.Edge Civic Sensing Platform - Environment Config
# ========================================================

# Google Gemini API Key (Multimodal Vision-Language Verification)
# Obtain from: https://aistudio.google.com/app/apikey
# If left blank, the built-in deterministic heuristic verifier will be used.
GEMINI_API_KEY=your_gemini_api_key_here

# Municipal Authority Jurisdiction Configuration
CIVIC_AUTHORITY="Greater Bengaluru Authority (GBA)"
CORPORATION="BBMP - East Zone"
DEFAULT_WARD=154

# Spatial Clustering & Triage Thresholds
CLUSTER_RADIUS_METERS=30.0
INDEPENDENT_VEHICLES_FOR_CONFIRMATION=2
RECURRENCE_THRESHOLD_FOR_BLACKSPOT=2

# VLM Inference Model
GEMINI_MODEL="gemini-1.5-flash"
